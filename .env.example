# Copia este archivo a .env.local y rellena con la configuración oficial de TU proyecto Firebase.
# NUNCA incluyas claves privadas ni credenciales de administrador aquí.
# Estos valores son públicos por diseño en Firebase Web SDK, pero deben corresponder a tu proyecto.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
