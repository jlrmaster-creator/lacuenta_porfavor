{
  "name": "la-cuenta-por-favor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA para registrar consumiciones individuales y compartidas en bares y restaurantes",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
